# Скопируйте этот файл в .env (Windows: copy .env.example .env). Все строки необязательные.

# Полный URL API организаторов с подписью, БЕЗ &group_id=... — нужен только для загрузки новых наборов.
# Набор DEV уже лежит в data/DEV.json. Не публикуйте этот URL.
CQA_API_URL=
PORT=3000
# STORAGE_DIR=storage
# Сколько диалогов оценивать одновременно
# EVAL_CONCURRENCY=5

# ---- Сервис модели (local-model/serve.py) ----
LOCAL_MODEL_URL=http://127.0.0.1:8000
# LOCAL_MODEL_PORT=8000
# LOCAL_MODEL_THREADS=4
# LOCAL_MODEL_TIMEOUT_MS=30000
